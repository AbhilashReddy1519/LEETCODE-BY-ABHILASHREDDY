{
	"cph.general.saveLocation": "${workspaceFolder}/compiled",

	"cph.language.cpp.command": "g++",
	"cph.language.cpp.args": [
		"-std=c++17",
		"-O2",
		"-o",
		"${workspaceFolder}/compiled/${fileBasenameNoExtension}.bin",
		"${file}"
	],

	"cph.language.java.command": "javac",
	"cph.language.java.args": ["-d", "${workspaceFolder}/compiled", "${file}"],

	"cph.language.python.command": "python",
	"cph.language.python.args": ["${file}"],

	"cph.language.c.command": "gcc",
	"cph.language.c.args": [
		"-O2",
		"-o",
		"${workspaceFolder}/compiled/${fileBasenameNoExtension}.bin",
		"${file}"
	]
}
